{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/amin/.local/bin/headroom wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/amin/projects/tauri/tauri-task-timer/scripts/task-timer-hook session_start",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/amin/projects/tauri/tauri-task-timer/scripts/task-timer-hook session_end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}

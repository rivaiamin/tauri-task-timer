# Path to the local SQLite database file (optional; defaults to local.db)
DATABASE_PATH=local.db

# --- JIRA sync (optional) ---
# When email + token are set (here or via JIRA_ENV_FILE), timer events update
# linked issues (key parsed from task label/description). Without creds, sync
# hooks are no-ops and the timer works normally.

# JIRA_EMAIL=you@example.com
# JIRA_TOKEN=your_api_token

# JIRA Cloud site (optional; default https://aimsis.atlassian.net)
# JIRA_SITE=https://aimsis.atlassian.net

# Fallback file for JIRA_EMAIL + JIRA_TOKEN (optional; default ~/.aimsis/jira.env)
# JIRA_ENV_FILE=~/.aimsis/jira.env

# Workflow status names (optional; defaults match AIMSIS JIRA)
# JIRA_STATUS_TODO=To Do
# JIRA_STATUS_INPROGRESS=In Progress
# JIRA_STATUS_DONE=Cek lokal
